# Add to the server environment only after applying and verifying migrations.
# Defaults deliberately keep existing deployments on their original behavior.
PRODUCT_SCOPE_ENABLED=false
RESEARCH_ENABLED=false
RESEARCH_JOBS_ENABLED=false
RESEARCH_ORIGIN=https://research.iterojm.com

# Reuse the existing project. Never expose these values in VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
GEMINI_API_KEY=replace-with-server-only-key
