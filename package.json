{
  "name": "iterojm-root",
  "main": "server/index.js",
  "private": true,
  "workspaces": [
    "admin",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\" \"npm run dev -w admin\"",
    "start": "npm start --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=admin",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "express": "^4.18.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.57.1",
    "@esbuild/linux-x64": "^0.27.2"
  }
}
