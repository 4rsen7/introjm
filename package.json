{
  "name": "iterojm-root",
  "main": "server/index.js",
  "private": true,
  "workspaces": [
    "admin",
    "client",
    "server",
    "research"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\" \"npm run dev -w admin\"",
    "dev:research": "concurrently \"npm run dev -w server\" \"npm run dev -w research\"",
    "build:research": "npm run build --workspace=research",
    "test:server": "node --test server/tests/*.test.js",
    "test:research-ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config=playwright.research.config.js",
    "start": "npm start --workspace=server",
    "deploy:hostinger": "bash ./scripts/deploy-hostinger.sh",
    "deploy:hostinger:ssh": "bash ./scripts/deploy-hostinger-over-ssh.sh",
    "install:playwright:chromium": "PLAYWRIGHT_BROWSERS_PATH=0 npm exec playwright install chromium",
    "build": "npm install --include=dev && npm run install:playwright:chromium && rm -rf server/public/client server/public/admin server/public/research && npm run build --workspace=client && npm run build --workspace=admin && npm run build --workspace=research",
    "install:all": "npm install",
    "seed:e2e": "node scripts/seed-e2e.js",
    "seed:e2e:local": "bash ./scripts/run-e2e-local.sh seed",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash ./scripts/run-e2e-local.sh test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke --workers=1",
    "test:e2e:smoke:local": "bash ./scripts/run-e2e-local.sh smoke",
    "worker:research": "npm run worker:research --workspace=server"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.54.2",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "overrides": {
    "@ant-design/pro-layout": {
      "path-to-regexp": "8.4.2"
    }
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.2",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1"
  }
}
