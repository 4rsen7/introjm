# Optional server-side deploy overrides for Hostinger.
# Copy this file to `.env.hostinger.deploy` on the server (do not commit it)
# if your SSH shell does not automatically expose the same env vars as hPanel.

# Frontend build-time values
VITE_SUPABASE_URL=https://onlcpxkvmvimbicivjlj.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key_here
VITE_API_BASE_URL=https://iterojm.com/api
VITE_LANDING_ORIGIN=https://iterojm.com
VITE_APP_ORIGIN=https://app.iterojm.com
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_side_token_here
VITE_PADDLE_ENV=production

# Backend Paddle billing values
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_PRO_PRODUCT_ID=pro_xxx
PADDLE_PRO_PRICE_ID_MONTHLY=pri_xxx
PADDLE_PRO_PRICE_ID_YEARLY=pri_xxx
PADDLE_ENTERPRISE_PRODUCT_ID=pro_xxx
PADDLE_ENTERPRISE_PRICE_ID_MONTHLY=pri_xxx
PADDLE_ENTERPRISE_PRICE_ID_YEARLY=pri_xxx

# Optional explicit output roots
# PUBLIC_HTML_DIR=/home/u364787514/domains/iterojm.com/public_html

# Optional restart command for the Node app after build/sync.
# Example:
# SERVER_RESTART_COMMAND=touch /home/u364787514/domains/iterojm.com/public_html/tmp/restart.txt
